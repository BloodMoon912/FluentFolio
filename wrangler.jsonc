{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluentfolio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  // The public demo is deployed as its own Worker with a custom domain. This
  // config intentionally declares no D1/KV/R2 bindings or secrets: the demo
  // renders the theme and its example content, while the admin CMS and the
  // visitor database stay unconfigured (their routes fail closed).
  "routes": [{ "pattern": "fluentfolio.bloodmoon912.de5.net", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    // `/*` keeps every document and API route on the Worker. `!` entries hand
    // matching static files to the asset layer: `/_astro/*` build output and
    // the `/brand/*` media directory (negative entries win over `/*`).
    "run_worker_first": ["/*", "!/_astro/*", "!/brand/*"],
  },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
    "issues": { "enabled": true },
  },
  "vars": {
    "TURNSTILE_HOSTNAMES": "fluentfolio.bloodmoon912.de5.net",
    // Empty Access settings keep the admin routes fail-closed (503) on the
    // public demo. Configure a Zero Trust application before enabling them.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ACCESS_ADMIN_AUD": "",
    "ACCESS_API_AUD": "",
    "ADMIN_WEBAUTHN_RP_ID": "fluentfolio.bloodmoon912.de5.net",
    "ADMIN_WEBAUTHN_ORIGIN": "https://fluentfolio.bloodmoon912.de5.net",
    "GITHUB_REPO": "BloodMoon912/fluentfolio",
    "GITHUB_BRANCH": "main",
    "R2_PUBLIC_BASE_URL": "",
  },
}
