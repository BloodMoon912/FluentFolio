# Only for local development. Never commit real secrets.
#
# Copy this file to `.dev.vars` (git-ignored) and fill in what you need. Missing
# values degrade gracefully: the affected panel or endpoint reports
# "not configured" instead of failing at startup.

# --- Public integrations -----------------------------------------------------
# Steam Web API key and the 64-bit SteamID of the profile to display.
STEAM_API_KEY=
STEAM_ID=
# Discord user ID that Lanyard is monitoring.
DISCORD_USER_ID=

# --- Build-time watermarking -------------------------------------------------
# HMAC key for the invisible zero-width signatures on novel/dictionary/world
# pages. Set it as a Workers Builds build variable, never commit a real value.
# When empty the build succeeds and watermarks are skipped (CI does the same).
WATERMARK_SECRET=

# --- Visitor analytics -------------------------------------------------------
# Salt used to hash visitor IPs. Required in production: when it is absent the
# API skips the D1 write and answers { recorded: false } instead of hashing with
# a predictable fallback. Set a long random string locally too.
VISITOR_SALT=
# Signs the __Host-bm-visit cookie. Falls back to TURNSTILE_SECRET when unset.
VISITOR_COOKIE_SECRET=
# VISITOR_RATE_LIMIT (60 requests / IP / minute, then 429) is a Workers Rate
# Limiting binding declared in wrangler.jsonc, not a variable here; it applies
# automatically in dev and production once the config is deployed.

# --- Cloudflare Access (required in production) ------------------------------
# Zero Trust team issuer, including https:// and without a trailing path.
ACCESS_TEAM_DOMAIN=
# Shared AUD when one Access application protects both /admin* and /api/admin/*.
ACCESS_AUD=
# If using separate Access applications, set each dedicated AUD instead.
ACCESS_ADMIN_AUD=
ACCESS_API_AUD=

# --- Admin CMS (/admin) ------------------------------------------------------
# Optional password fallback. Keep this configured during initial Passkey setup;
# if removed later, only already-enrolled Passkeys can sign in.
ADMIN_PASSWORD=
# Signs the __Host-bm-admin session cookie and WebAuthn challenge cookie.
# Without this, both Passkey and password login are disabled and the CMS returns 503.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# WebAuthn RP settings must match the canonical public site origin.
# Leave blank for local development; the application derives localhost.
# Production values are configured in wrangler.jsonc.
ADMIN_WEBAUTHN_RP_ID=
ADMIN_WEBAUTHN_ORIGIN=
# Fine-grained GitHub PAT: Contents read and write on the one repository the
# CMS commits to (this repository, or your private content repository in the
# optional private-content mode, docs/PRIVATE-CONTENT-REPO.md).
GITHUB_TOKEN=
GITHUB_REPO=your-name/fluentfolio
GITHUB_BRANCH=main
# Discord Incoming Webhook used for the "new post published" notification.
DISCORD_BLOG_WEBHOOK_URL=
# Public base URL that serves the BLOG_IMAGES bucket.
R2_PUBLIC_BASE_URL=

# --- Turnstile (bot protection for POST /api/visitors) -----------------------
# Secret key of the Turnstile widget. With it set, the visitor endpoint requires
# a verified token; without it the endpoint fails open, works exactly as it did
# before Turnstile existed, and logs a warning.
TURNSTILE_SECRET=
# Hostname allow-list checked against what siteverify reports. Required whenever
# the secret is set: an empty value fails closed. Locally this is the dev list;
# production sets its own in wrangler.jsonc and must never include localhost.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# --- OPTIONAL private content repo: BUILD-time only (scripts/fetch-content.mjs) ---
# Ignore this block unless you follow docs/PRIVATE-CONTENT-REPO.md.
# These are Workers Builds *build variables/secrets*, not Worker runtime
# secrets, and are not read by the Worker. They are only needed locally if you
# want `npm run fetch:content` to clone instead of `--from ../fluentfolio-content`.
# CONTENT_REPO defaults to your-name/fluentfolio-content.
CONTENT_REPO=
# Fine-grained PAT, Contents: READ-ONLY, on the content repo only.
CONTENT_REPO_TOKEN=
CONTENT_REF=main
# 1 = fail the build if content cannot be fetched (the default on Workers
# Builds); 0 = never fail.
CONTENT_REQUIRED=
