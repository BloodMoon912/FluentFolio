---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FluentIcon from '../../../components/FluentIcon.astro';
import PostBadge from '../../../components/PostBadge.astro';
import ReadingProgress from '../../../components/ReadingProgress.astro';
import TOC from '../../../components/TOC.astro';
import { estimateReadingMinutes, formatHKTDate } from '../../../lib/time';
import { profile } from '../../../lib/data';
import { t as tr } from '../../../lib/i18n';

// Reading pages are prerendered: their output depends only on the content
// collections, so it can be produced once at build time. `getEntry`/`render`
// below still run — just during the build instead of per request — and the
// `BaseLayout` <Image> resolves to real build-time variants instead of a
// request-time transform (`imageService: 'compile'`).
export const prerender = true;

/**
 * One page per published essay. `entry.id` is what the rest parameter carries
 * (`[...slug]` keeps a nested id such as `guides/setup` intact), which is also
 * the id the page hands to `getEntry`, so the two can never disagree.
 */
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;

// Unreachable at build time: `getStaticPaths` only enumerates published entries,
// and the empty path is not generated. Kept as a defensive guard so a future
// route change degrades to a redirect instead of a render error.
if (!slug) {
  return Astro.redirect('/posts?tab=blog');
}

const post = await getEntry('blog', slug);

if (!post || post.data.draft) {
  return Astro.redirect('/404');
}

const { Content, headings } = await render(post);
const { title, description, date, updatedDate, category, tags, author } = post.data;
const readingMinutes = estimateReadingMinutes(post.body ?? '');

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((candidate) => candidate.id !== post.id)
  .map((candidate) => {
    const sharedTags = candidate.data.tags.filter((tag) => tags.includes(tag)).length;
    const sameCategory = candidate.data.category === category ? 1 : 0;
    return { candidate, score: sharedTags * 2 + sameCategory };
  })
  .filter((entry) => entry.score > 0)
  .sort((a, b) => b.score - a.score || b.candidate.data.date.valueOf() - a.candidate.data.date.valueOf())
  .slice(0, 3)
  .map((entry) => entry.candidate);
---

<BaseLayout
  title={`${title} · ${profile.nameShort}`}
  description={description}
  ogImage={post.id.includes('/') ? '/og.png' : `/og/${post.id}.png`}
  ogType="article"
>
  <ReadingProgress />

  <article class="page post-page">
    <div class="article-back">
      <a class="back-link" href="/posts?tab=blog" data-i18n="back_to_posts">
        <FluentIcon name="arrow-left" size={16} class="back-link-icon" />
        {tr('zh', 'back_to_posts')}
      </a>
    </div>

    <div class="article-layout">
      <TOC headings={headings} label={tr('zh', 'toc_label')} />

      <div class="article-main">
        <header class="post-header">
          <div class="eyebrow">
            <PostBadge kind="blog" />
            <span>{category}</span>
          </div>
          <h1 class="page-title">{title}</h1>
          <p class="lead">{description}</p>
          <div class="post-meta post-byline">
            <span>{author}</span>
            <span>·</span>
            <time datetime={date.toISOString()} data-i18n="published" data-i18n-args={formatHKTDate(date)}>
              {tr('zh', 'published', formatHKTDate(date))}
            </time>
            {updatedDate && (
              <>
                <span>·</span>
                <time
                  datetime={updatedDate.toISOString()}
                  data-i18n="updated"
                  data-i18n-args={formatHKTDate(updatedDate)}
                >
                  {tr('zh', 'updated', formatHKTDate(updatedDate))}
                </time>
              </>
            )}
            <span>·</span>
            <span data-i18n="reading_time" data-i18n-args={String(readingMinutes)}>
              {tr('zh', 'reading_time', String(readingMinutes))}
            </span>
          </div>
          <div class="tags">
            {tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        </header>

        <div class="markdown-content">
          <Content />
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="related-posts">
        <h2>{tr('zh', 'related_posts')}</h2>
        <div class="article">
          {related.map((item) => (
            <article class="card blog-preview">
              <div class="post-meta">
                <time datetime={item.data.date.toISOString()}>{formatHKTDate(item.data.date)}</time>
                <span>·</span>
                <span>{item.data.category}</span>
              </div>
              <h2>
                <a href={`/posts/blog/${item.id}`}>{item.data.title}</a>
              </h2>
              <p>{item.data.description}</p>
              <a class="text-link" href={`/posts/blog/${item.id}`} data-i18n="read_more">
                {tr('zh', 'read_more')}
              </a>
            </article>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
