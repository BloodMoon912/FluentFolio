---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteSearch from '../../components/SiteSearch.astro';
import FluentIcon from '../../components/FluentIcon.astro';
import { t as tr } from '../../lib/i18n';

const entries = (await getCollection('dictionary', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.word.localeCompare(b.data.word),
);
---

<BaseLayout titleKey="title_dictionary" description={tr('zh', 'dictionary_lead')}>
  <section class="page">
    <div class="blog-heading">
      <div>
        <div class="eyebrow">{tr('zh', 'dictionary_eyebrow')}</div>
        <h1 class="page-title">{tr('zh', 'dictionary_page_title')}</h1>
        <p class="lead">{tr('zh', 'dictionary_lead')}</p>
      </div>
    </div>

    <p class="content-count">{tr('zh', 'dictionary_count', String(entries.length))}</p>

    <!-- One search entry per page: same component/engine as the topbar field,
         locked to the dictionary. Kept outside the empty branch on purpose. -->
    <SiteSearch
      id="dictionary-search"
      variant="inline"
      lockedKind="dictionary"
      placeholderKey="search_dictionary_placeholder"
      filterList="#dictionary-list"
      syncQuery
    />

    {entries.length === 0 ? (
      <article class="card blog-preview empty-state">
        <h2>{tr('zh', 'dictionary_empty')}</h2>
      </article>
    ) : (
      <div id="dictionary-list" class="wiki-grid" data-filter-list>
        {entries.map((entry) => (
          <a class="wiki-card" href={`/dictionary/${entry.id}`} data-entry-id={entry.id}>
            <span class="wiki-card__title">
              {entry.data.word}
              {entry.data.ipa && <span class="wiki-card__ipa">{entry.data.ipa}</span>}
            </span>
            <span class="wiki-card__desc">{entry.data.definition}</span>
            <span class="wiki-card__meta">{entry.data.partOfSpeech}</span>
          </a>
        ))}
      </div>
    )}

    <div class="actions" style="margin-top:32px">
      <a class="btn" href="/world">
        {tr('zh', 'title_world')}
        <FluentIcon name="arrow-right" size={16} />
      </a>
    </div>
  </section>
</BaseLayout>
