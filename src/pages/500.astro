---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t as tr } from '../lib/i18n';
---

<BaseLayout titleKey="title_500" description={tr('zh', 'error_title')}>
  <section class="error-page">
    <div>
      <div class="error-code">500</div>
      <h1 data-i18n="error_title">{tr('zh', 'error_title')}</h1>
      <p data-i18n="error_lead">{tr('zh', 'error_lead')}</p>
      <div class="actions" style="justify-content:center">
        <a class="btn primary" href="/" data-i18n="back_home">
          {tr('zh', 'back_home')}
        </a>
        <a class="btn" href="/status" data-i18n="system_status_link">
          {tr('zh', 'system_status_link')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
