---
// Unified search component.
//
// Placements:
//   topbar  — whole-site field in the desktop shell
//   menu    — mobile-menu counterpart
//   inline  — an additional page-level field on /posts, /dictionary and /world;
//             it locks the content type and filters that page's list in place.
//
// The index (`/search-index.json`) and the Fuse configuration live in
// `src/lib/search-core.ts`; this component only renders and binds behaviour.

import FluentIcon from './FluentIcon.astro';
import { t as tr } from '../lib/i18n';
import { SEARCH_KINDS, type SearchKind } from '../lib/search-core';

interface Props {
  /** Unique DOM id; placements must not collide. */
  id?: string;
  variant?: 'topbar' | 'menu' | 'inline';
  /** Inline only: lock the search to one collection. */
  lockedKind?: SearchKind;
  /** Inline only: i18n key for the visible placeholder. */
  placeholderKey?: string;
  /** Inline only: selector for the server-rendered list to filter. */
  filterList?: string;
  /** Inline only: mirror the query and selected tag into the current URL. */
  syncQuery?: boolean;
  /** Inline only: optional blog tag facet. */
  filterTags?: string[];
}

const {
  id = 'site-search',
  variant = 'topbar',
  lockedKind,
  placeholderKey = 'search_placeholder',
  filterList,
  syncQuery = false,
  filterTags = [],
} = Astro.props;

const label = tr('zh', 'search_label');
const placeholder = tr('zh', placeholderKey);
const listId = `${id}-list`;
const showFilters = variant !== 'inline';
---

<div
  class="site-search"
  id={id}
  data-site-search
  data-variant={variant}
  data-locked-kind={lockedKind}
  data-filter-list={filterList}
  data-sync-query={syncQuery ? 'true' : undefined}
>
  <div class="site-search__field">
    <FluentIcon name="search" size={18} class="site-search__icon" />
    <input
      id={`${id}-input`}
      class="site-search__input"
      type="search"
      name="q"
      placeholder={placeholder}
      aria-label={label}
      data-i18n-ph={placeholderKey}
      data-i18n-aria="search_label"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      role="combobox"
      aria-autocomplete="list"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-controls={listId}
      data-search-input
    />
    <kbd class="site-search__kbd" aria-hidden="true">
      {' '}
      /{' '}
    </kbd>
  </div>

  {variant === 'inline' && filterTags.length > 0 && (
    <label class="site-search__tag-filter">
      <span data-i18n="search_tag_filter">{tr('zh', 'search_tag_filter')}</span>
      <select aria-label={tr('zh', 'search_tag_filter')} data-i18n-aria="search_tag_filter" data-search-tag-filter>
        <option value="" data-i18n="search_all_tags">
          {tr('zh', 'search_all_tags')}
        </option>
        {filterTags.map((tag) => (
          <option value={tag}>{tag}</option>
        ))}
      </select>
    </label>
  )}

  <div class="site-search__panel" data-search-panel hidden>
    {showFilters && (
      <div class="site-search__filters" role="group" aria-label={label} data-search-filters>
        <button
          type="button"
          class="site-search__filter is-active"
          data-search-kind="all"
          aria-pressed="true"
          data-i18n="search_all"
        >
          {tr('zh', 'search_all')}
        </button>
        {SEARCH_KINDS.map((kind) => (
          <button
            type="button"
            class="site-search__filter"
            data-search-kind={kind}
            aria-pressed="false"
            data-i18n={`search_kind_${kind}`}
          >
            {tr('zh', `search_kind_${kind}`)}
          </button>
        ))}
      </div>
    )}
    <p class="site-search__hint" data-search-hint data-i18n="search_hint">
      {tr('zh', 'search_hint')}
    </p>
    <div
      class="site-search__results"
      id={listId}
      role="listbox"
      aria-label={label}
      data-i18n-aria="search_label"
      data-search-results
    ></div>
    <p class="site-search__empty" data-search-empty data-i18n="search_no_results" hidden>
      {tr('zh', 'search_no_results')}
    </p>
    <p class="site-search__status" data-search-status aria-live="polite" hidden></p>
  </div>
</div>

<script>
  import { escapeHtml } from '../lib/escape-html';
  import { safeInternalSearchUrl } from '../lib/search-url';
  import {
    SEARCH_KINDS,
    SEARCH_KIND_I18N,
    getSearchEngine,
    highlight,
    normalizeSearchQuery,
    parseSearchState,
    searchHref,
    type SearchDocument,
    type SearchEngine,
    type SearchKind,
  } from '../lib/search-core';

  type KindFilter = 'all' | SearchKind;

  interface SearchInstance {
    root: HTMLElement;
    input: HTMLInputElement;
    panel: HTMLElement;
    list: HTMLElement;
    hint: HTMLElement | null;
    empty: HTMLElement;
    status: HTMLElement;
    filters: HTMLElement | null;
    options: HTMLAnchorElement[];
    active: number;
    composing: boolean;
    engine: SearchEngine | null;
    activeKind: KindFilter;
    lockedKind: SearchKind | null;
    filterList: string | null;
    tagFilter: HTMLSelectElement | null;
    syncQuery: boolean;
    /** Inline only: "no results" line after the page list. */
    inlineEmpty: HTMLElement | null;
  }

  interface RenderGroup {
    key: string;
    label: string;
    items: SearchDocument[];
  }

  const MAX_RESULTS = 8;
  const instances: SearchInstance[] = [];
  const KIND_I18N: Record<SearchKind, string> = SEARCH_KIND_I18N;

  function translate(key: string, ...args: unknown[]): string {
    const dict = window.T;
    return dict ? dict(key, ...args) : key;
  }

  function translateKind(kind: string): string {
    const key = (KIND_I18N as Record<string, string | undefined>)[kind];
    return key ? translate(key) : kind.toUpperCase();
  }

  function isLockedFill(instance: SearchInstance): KindFilter {
    return instance.lockedKind ?? instance.activeKind;
  }

  function activeKind(instance: SearchInstance): SearchKind | undefined {
    const kind = isLockedFill(instance);
    return kind === 'all' ? undefined : kind;
  }

  function matchesFor(instance: SearchInstance, query: string): SearchDocument[] {
    if (!instance.engine) return [];
    return instance.engine.search(query, activeKind(instance), instance.tagFilter?.value || undefined);
  }

  function previewFor(instance: SearchInstance): SearchDocument[] {
    if (!instance.engine) return [];
    return instance.engine.preview(activeKind(instance));
  }

  async function ensureEngine(instance: SearchInstance): Promise<void> {
    if (instance.engine) return;
    try {
      instance.engine = await getSearchEngine();
    } catch (error: unknown) {
      console.warn('[site-search] could not load the search index', error);
    }
  }

  function setActiveFilter(instance: SearchInstance, kind: KindFilter): void {
    if (instance.lockedKind) return;
    instance.activeKind = kind;
    for (const button of instance.filters?.querySelectorAll<HTMLButtonElement>('[data-search-kind]') ?? []) {
      const active = button.dataset.searchKind === kind;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    }
  }

  function syncUrl(instance: SearchInstance): void {
    if (!instance.syncQuery) return;
    const query = normalizeSearchQuery(instance.input.value);
    // The novel panel has no blog-tag selector. Preserve an existing tag in
    // the URL while that panel is active so its hidden sibling can restore it.
    const tag = instance.tagFilter ? instance.tagFilter.value : parseSearchState(location.search).tag;
    const next = searchHref(location.pathname, { query, tag }, location.search);
    history.replaceState(history.state, '', next);
  }

  /**
   * Restore the original server-rendered order when the query is cleared. Only
   * rows that share one parent are moved: the novel panel nests each chapter row
   * inside its volume group's `<li>`, and reparenting those anchors would destroy
   * the list markup instead of reordering it.
   */
  function restoreListOrder(items: HTMLElement[]): void {
    const parent = items[0]?.parentElement ?? null;
    if (!parent || items.some((item) => item.parentElement !== parent)) return;
    items.sort((a, b) => Number(a.dataset.entryOrder ?? 0) - Number(b.dataset.entryOrder ?? 0));
    for (const item of items) parent.append(item);
  }

  /** Apply the ranked result order and hide non-matches in the page list. */
  function applyInlineFilter(instance: SearchInstance, query: string, matches: SearchDocument[]): void {
    if (!instance.filterList) return;
    const list = document.querySelector<HTMLElement>(instance.filterList);
    if (!list) return;
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-entry-id]'));
    if (items.length === 0) return;

    const normalized = normalizeSearchQuery(query);
    const hasTag = Boolean(instance.tagFilter?.value);
    if (!normalized && !hasTag) {
      restoreListOrder(items);
      for (const item of items) item.hidden = false;
      if (instance.inlineEmpty) instance.inlineEmpty.hidden = true;
      return;
    }

    const rank = new Map(matches.map((match, index) => [match.id, index]));
    let visible = 0;
    for (const item of items) {
      const matched = rank.has(item.dataset.entryId ?? '');
      item.hidden = !matched;
      if (matched) visible += 1;
    }
    // The rows below are the page's own list, not the dropdown, so a no-match
    // query would otherwise leave a blank area with no explanation.
    if (instance.inlineEmpty) instance.inlineEmpty.hidden = visible > 0;
    const ordered = [...items].sort((a, b) => {
      const ar = rank.get(a.dataset.entryId ?? '') ?? Number.MAX_SAFE_INTEGER;
      const br = rank.get(b.dataset.entryId ?? '') ?? Number.MAX_SAFE_INTEGER;
      return ar - br;
    });
    // Nested lists keep their structure; hiding is the whole effect there.
    const parent = items[0]?.parentElement ?? null;
    if (!parent || items.some((item) => item.parentElement !== parent)) return;
    for (const item of ordered) parent.append(item);
  }

  function groupMatches(items: SearchDocument[]): RenderGroup[] {
    const buckets = new Map<string, SearchDocument[]>();
    for (const item of items) {
      const bucket = buckets.get(item.kind);
      if (bucket) bucket.push(item);
      else buckets.set(item.kind, [item]);
    }
    const groups: RenderGroup[] = [];
    for (const kind of SEARCH_KINDS) {
      const bucket = buckets.get(kind);
      if (bucket && bucket.length > 0) groups.push({ key: kind, label: translateKind(kind), items: bucket });
    }
    return groups;
  }

  function applyActive(instance: SearchInstance): void {
    instance.options.forEach((option, index) => {
      const selected = index === instance.active;
      option.classList.toggle('is-active', selected);
      option.setAttribute('aria-selected', selected ? 'true' : 'false');
    });
    const current = instance.active >= 0 ? instance.options[instance.active] : null;
    if (current) {
      instance.input.setAttribute('aria-activedescendant', current.id);
      current.scrollIntoView({ block: 'nearest', behavior: 'instant' });
    } else {
      instance.input.removeAttribute('aria-activedescendant');
    }
  }

  function renderPanel(instance: SearchInstance): void {
    const query = normalizeSearchQuery(instance.input.value);
    const hasQuery = query.length > 0;
    const hasTag = Boolean(instance.tagFilter?.value);
    const hasFilter = hasQuery || hasTag;
    const matches = hasFilter ? matchesFor(instance, query) : previewFor(instance);
    const shown = matches.slice(0, MAX_RESULTS);

    const groups: RenderGroup[] = hasFilter
      ? groupMatches(shown)
      : shown.length > 0
        ? [{ key: 'all', label: translate('search_all'), items: shown }]
        : [];

    let optionIndex = 0;
    instance.list.innerHTML = groups
      .map((group) => {
        const headingId = `${instance.list.id}-${group.key}`;
        const rows = group.items
          .map((item) => {
            const optionId = `${instance.list.id}-option-${optionIndex}`;
            optionIndex += 1;
            const safeUrl = safeInternalSearchUrl(item.url, window.location.origin);
            if (!safeUrl) return '';
            const href = escapeHtml(safeUrl);
            return `<a class="site-search__item" role="option" aria-selected="false" id="${escapeHtml(optionId)}" href="${href}" data-search-url="${href}"><span class="site-search__item-title">${highlight(item.title, query)}</span><span class="site-search__item-kind">${escapeHtml(translateKind(item.kind))}</span><span class="site-search__item-desc">${highlight(item.description, query)}</span></a>`;
          })
          .join('');
        return `<div class="site-search__group" role="group" aria-labelledby="${escapeHtml(headingId)}"><p class="site-search__group-head" id="${escapeHtml(headingId)}">${escapeHtml(group.label)}</p>${rows}</div>`;
      })
      .join('');

    instance.empty.hidden = !hasFilter || shown.length > 0;
    if (instance.hint) instance.hint.hidden = hasFilter;
    instance.status.hidden = !hasFilter;
    instance.status.textContent = hasFilter ? translate('search_results', matches.length) : '';
    instance.options = Array.from(instance.list.querySelectorAll<HTMLAnchorElement>('.site-search__item'));
    instance.active = instance.options.length > 0 ? 0 : -1;
    applyActive(instance);

    // Never hide page rows when the index is unavailable: the open panel already
    // says "no results", but a blanked list would outlive the panel and look like
    // the page is empty.
    if (hasFilter && instance.engine) applyInlineFilter(instance, query, matches);
    else applyInlineFilter(instance, '', []);
    syncUrl(instance);
  }

  function showPanel(instance: SearchInstance): void {
    if (instance.panel.hidden) {
      instance.panel.hidden = false;
      instance.root.classList.add('is-open');
      instance.input.setAttribute('aria-expanded', 'true');
    }
    renderPanel(instance);
    if (!instance.engine) {
      void ensureEngine(instance).then(() => {
        if (!instance.panel.hidden) renderPanel(instance);
      });
    }
  }

  function closePanel(instance: SearchInstance): void {
    if (instance.panel.hidden) return;
    instance.panel.hidden = true;
    instance.root.classList.remove('is-open');
    instance.input.setAttribute('aria-expanded', 'false');
    instance.input.removeAttribute('aria-activedescendant');
    instance.active = -1;
  }

  function moveActive(instance: SearchInstance, delta: number): void {
    if (instance.options.length === 0) return;
    instance.active = Math.max(0, Math.min(instance.options.length - 1, instance.active + delta));
    applyActive(instance);
  }

  function follow(url: string): void {
    const safeUrl = safeInternalSearchUrl(url, window.location.origin);
    if (!safeUrl) return;
    const anchor = document.createElement('a');
    anchor.href = safeUrl;
    anchor.hidden = true;
    document.body.append(anchor);
    anchor.click();
    anchor.remove();
  }

  function dismissShell(): void {
    const menu = document.getElementById('mobile-menu');
    if (menu) menu.classList.remove('open');
    const toggle = document.getElementById('nav-toggle');
    if (toggle) {
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    }
  }

  function activeOption(instance: SearchInstance): HTMLAnchorElement | null {
    return instance.active >= 0 ? (instance.options[instance.active] ?? null) : null;
  }

  /** Mirror `?q=` / `?tag=` from the URL into an inline instance and its page list. */
  function syncInlineFromUrl(instance: SearchInstance, closeWhenDone: boolean): void {
    if (!instance.syncQuery) return;
    const state = parseSearchState(location.search);
    instance.input.value = state.query;
    if (instance.tagFilter) instance.tagFilter.value = state.tag;
    void ensureEngine(instance).then(() => {
      // If the index could not be fetched, leave the server-rendered list alone:
      // filtering against an empty engine would hide every row and the panel is
      // closed, so a shared ?q= URL would blank the page with no explanation.
      if (!instance.engine) return;
      renderPanel(instance);
      if (closeWhenDone) closePanel(instance);
    });
  }

  function bootInlineQuery(instance: SearchInstance): void {
    const state = parseSearchState(location.search);
    if (!state.query && !state.tag) return;
    syncInlineFromUrl(instance, true);
  }

  function initInstance(root: HTMLElement): void {
    if (root.dataset.searchReady === 'true' && root.isConnected) return;
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const panel = root.querySelector<HTMLElement>('[data-search-panel]');
    const list = root.querySelector<HTMLElement>('[data-search-results]');
    const empty = root.querySelector<HTMLElement>('[data-search-empty]');
    const status = root.querySelector<HTMLElement>('[data-search-status]');
    if (!input || !panel || !list || !empty || !status) return;

    const lockedKind = (root.dataset.lockedKind as SearchKind | undefined) ?? null;
    const filterList = root.dataset.filterList ?? null;
    const syncQuery = root.dataset.syncQuery === 'true';
    // Inline search hides rows in the server-rendered list; without a line of
    // its own a no-match query would leave a blank page below the field.
    let inlineEmpty: HTMLElement | null = null;
    if (filterList && syncQuery) {
      const pageList = document.querySelector<HTMLElement>(filterList);
      if (pageList) {
        inlineEmpty = document.createElement('p');
        inlineEmpty.className = 'site-search__inline-empty';
        inlineEmpty.dataset.i18n = 'search_no_results';
        inlineEmpty.textContent = translate('search_no_results');
        inlineEmpty.hidden = true;
        // Appended inside the filtered container so it hides and shows with its
        // own tab panel.
        pageList.append(inlineEmpty);
      }
    }
    const instance: SearchInstance = {
      root,
      input,
      panel,
      list,
      hint: root.querySelector<HTMLElement>('[data-search-hint]'),
      empty,
      status,
      filters: root.querySelector<HTMLElement>('[data-search-filters]'),
      options: [],
      active: -1,
      composing: false,
      engine: null,
      activeKind: lockedKind ?? 'all',
      lockedKind,
      filterList,
      tagFilter: root.querySelector<HTMLSelectElement>('[data-search-tag-filter]'),
      syncQuery,
      inlineEmpty,
    };
    root.dataset.searchReady = 'true';
    instances.push(instance);

    // Remember the server order once, so clearing the query can restore it.
    if (filterList) {
      document.querySelectorAll<HTMLElement>(`${filterList} [data-entry-id]`).forEach((item, index) => {
        item.dataset.entryOrder = String(index);
      });
    }

    input.addEventListener('focus', () => showPanel(instance));
    input.addEventListener('click', () => showPanel(instance));
    root.querySelector<HTMLElement>('.site-search__field')?.addEventListener('click', (event) => {
      if (event.target === input) return;
      input.focus();
    });
    input.addEventListener('compositionstart', () => {
      instance.composing = true;
    });
    input.addEventListener('compositionend', () => {
      instance.composing = false;
      showPanel(instance);
    });
    input.addEventListener('input', () => {
      if (!instance.composing) showPanel(instance);
    });
    instance.tagFilter?.addEventListener('change', () => showPanel(instance));

    instance.filters?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLButtonElement>('[data-search-kind]');
      if (!button) return;
      setActiveFilter(instance, (button.dataset.searchKind as KindFilter) ?? 'all');
      renderPanel(instance);
      input.focus();
    });

    input.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        if (instance.panel.hidden) return;
        event.preventDefault();
        closePanel(instance);
        return;
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (instance.panel.hidden) showPanel(instance);
        else moveActive(instance, 1);
        return;
      }
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (!instance.panel.hidden) moveActive(instance, -1);
        return;
      }
      if (event.key === 'Enter') {
        if (instance.panel.hidden) return;
        const option = activeOption(instance);
        if (!option) return;
        event.preventDefault();
        const url = option.dataset.searchUrl ?? option.getAttribute('href') ?? '';
        closePanel(instance);
        dismissShell();
        follow(url);
        return;
      }
      if (event.key === 'Tab') closePanel(instance);
    });

    bootInlineQuery(instance);
  }

  function initAll(): void {
    document.querySelectorAll<HTMLElement>('[data-site-search]').forEach(initInstance);
  }

  initAll();

  document.addEventListener('pointerdown', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    for (const instance of instances) {
      if (!instance.root.isConnected) continue;
      if (!instance.root.contains(target)) closePanel(instance);
    }
  });

  function visibleInstance(): SearchInstance | null {
    for (const instance of instances) {
      if (!instance.root.isConnected) continue;
      const style = window.getComputedStyle(instance.root);
      if (style.visibility === 'hidden' || style.display === 'none') continue;
      if (instance.root.getClientRects().length === 0) continue;
      return instance;
    }
    return null;
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.defaultPrevented) return;
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target;
    if (target instanceof HTMLElement) {
      if (target.isContentEditable) return;
      if (/^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
    }
    const instance = visibleInstance();
    if (!instance) return;
    event.preventDefault();
    instance.input.focus();
    instance.input.select();
  });

  window.addEventListener('bm:lang', () => {
    for (const instance of instances) {
      if (instance.root.isConnected && !instance.panel.hidden) renderPanel(instance);
    }
  });

  const closeAll = () => {
    for (const instance of instances) if (instance.root.isConnected) closePanel(instance);
  };

  // Swup replaces <main>, so inline instances are fresh nodes; shell instances
  // survive but their panels should not outlive the old page.
  document.addEventListener('swup:page:view', () => {
    closeAll();
    for (let index = instances.length - 1; index >= 0; index -= 1) {
      if (!instances[index].root.isConnected) instances.splice(index, 1);
    }
    initAll();
  });
  document.addEventListener('swup:content:replace', closeAll);

  // /posts renders one inline search per tab panel. The tab switch only toggles
  // `hidden`, so the panel that becomes visible has to pick up the shared
  // ?q=/?tag= state instead of showing its boot-time list.
  document.addEventListener('bm:inline-search-sync', () => {
    for (const instance of instances) {
      if (instance.root.isConnected) syncInlineFromUrl(instance, false);
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('.site-search__item')) return;
    closeAll();
    dismissShell();
  });
</script>
